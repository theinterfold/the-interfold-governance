# PUBLIC ENV VARS — Sepolia
# Static values below are the current Interfold Sepolia deployment.
# Fill DAO + plugin addresses + deployment block from the `make deploy` output.

# General
NEXT_PUBLIC_DAO_ADDRESS=0x4A5CFB12E97E877fd73Cb04F0EfF5e04B30Fd586  # from deploy output
# RPC: prefer the SERVER-ONLY variable — the browser then calls /api/rpc, which relays to it,
# so a keyed endpoint never ships in the client bundle (INV-27). Only set the NEXT_PUBLIC one
# for a keyless public endpoint. The endpoint must allow historical eth_getLogs (log scans).
WEB3_RPC_URL=                                                              # server-only, keyed endpoint
# NEXT_PUBLIC_WEB3_ENDPOINT=                                               # optional keyless override
NEXT_PUBLIC_TOKEN_ADDRESS=0x3192Ee1FeE48159807058aA78038cf80cB3450Cb  # FOLD (timestamp-clock ERC20Votes)
# BondedVotes: reads the votes of its source plus FOLD bonded as ciphernode collateral and vesting
# FOLD. As on mainnet, the source of this one is the escrow adapter: locked FOLD that is delegated
# on the adapter counts, and wallet FOLD does not. Balances and voting power are read from here;
# locked FOLD delegates on the escrow adapter, which is why these are separate. `delegate()` on
# this address reverts `DelegationNotSupported`.
# Its own delegation is bonded delegation (`delegateBonded`/`acceptBonded`/`dropBonded`): an owner
# gives its bonded and vesting FOLD to one delegate, and a delegate represents at most 3 owners.
# The app shows those controls only when the adapter has them (adapters deployed before it do not).
# Optional: unset falls back to the token, and bonded weight is simply invisible.
NEXT_PUBLIC_BONDED_VOTES_ADDRESS=0xfbd932BD297e9C7261A384925E78371C7B1FEc7a  # BondedVotes adapter
# Block the BondedVotes adapter was deployed at — where the scan for bonded delegation requests
# starts. Optional: unset scans from block 0, which is correct but slow.
NEXT_PUBLIC_BONDED_VOTES_DEPLOYMENT_BLOCK=12050190  # BondedVotes deployment block
# VotingEscrow ("velocker"): lock FOLD for voting power. Only the escrow address is needed —
# the lock NFT, exit queue and IVotes adapter are read off it on-chain. Locked votes delegate
# on the adapter, NOT the token. Optional: unset hides the locking section entirely.
# (mainnet escrow: 0x71360F335e4Ec9c010e29bA7171bc62c9B4c1F12)
NEXT_PUBLIC_VE_LOCKER_ADDRESS=0xDfcA4d9769E0Fb6Ab93413A8c43DCeBF4055C1BC  # VotingEscrow (velocker)
NEXT_PUBLIC_INTERFOLD_FEE_TOKEN_ADDRESS=0xE2e534F7Cb95777eD870CDCaCb80B1E9E2aD555B  # Interfold testnet fee token (MockUSDC)
NEXT_PUBLIC_FAUCET_ADDRESS=0xfe24bCEdfc3305468c9523a9b9724c00c2cc138d  # testnet VotingFaucet: each faucet() sends FOLD for one more voting weight (up to 5) + 1000 fee token
NEXT_PUBLIC_ENABLE_FAUCET=true  # testnet only — leave unset/false in production

# Plugin addresses
# CRISP plugin -> PRIVATE (encrypted) proposals
NEXT_PUBLIC_CRISP_VOTING_PLUGIN_ADDRESS=0xeE50FAAC6006e302eB0308307a5b8A27409EBf05  # from deploy output (index 0)
# TokenVoting plugin -> PUBLIC proposals (FOLD ERC20Votes token)
NEXT_PUBLIC_TOKEN_VOTING_PLUGIN_ADDRESS=0xE99Ea5146aE62e8D86C62a9a29E1ADb2D1D730f4  # from deploy output (index 1)
# Staged Proposal Processor (SPP) instances — proposals are created on these,
# which auto-create the stage-0 sub-proposal on the voting body and hold a
# stage-1 foundation veto window before execution.
NEXT_PUBLIC_SPP_PRIVATE_ADDRESS=0xE01DC46CEeb6509a8124Ec904F6E925e0D74e33C  # SPP wrapping the CRISP body (from deploy output)
NEXT_PUBLIC_SPP_PUBLIC_ADDRESS=0xCB8D916a7BFbA60407f28020E2803E83aE9C64B2  # SPP wrapping the TokenVoting body (from deploy output)
# Optional: the private pair (SPP + CRISP body) that a replacement install retired. The list and
# the proposal page still show its proposals. Set both or neither, as checksummed addresses.
# NEXT_PUBLIC_RETIRED_SPP_PRIVATE_ADDRESS=
# NEXT_PUBLIC_RETIRED_CRISP_VOTING_PLUGIN_ADDRESS=

NEXT_PUBLIC_SECONDS_PER_BLOCK=12

# The block where the DAO/plugins were deployed (speeds up event queries)
NEXT_PUBLIC_PLUGIN_DEPLOYMENT_BLOCK=12050871  # from deploy output

# Interfold — hosted CRISP server
NEXT_PUBLIC_CRISP_SERVER_URL="https://private-crisp.theinterfold.com"
NEXT_PUBLIC_CRISP_PROGRAM_ADDRESS=0x25Df8D3C04D67efb6198E215963d19a8d119ADFF  # CRISPProgram — on-chain round data

# Network and services
NEXT_PUBLIC_CHAIN_NAME=sepolia
# Keyed endpoints belong in the server-only WEB3_RPC_URL at the top of this file — leaving this
# unset makes the browser use the /api/rpc relay. Set it only for a keyless public endpoint.
# NEXT_PUBLIC_WEB3_ENDPOINT=

NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="YOUR WALLET CONNECT PROJECT ID"

NEXT_PUBLIC_IPFS_ENDPOINTS="https://domain1/api,https://domain2/api/v0"
# SERVER-ONLY (no NEXT_PUBLIC_ prefix): read by pages/api/ipfs/pin.ts.
# A NEXT_PUBLIC_ prefix would inline this into the client bundle.
PINATA_JWT="..."

# SERVER-ONLY: read by pages/api/etherscan.ts.
ETHERSCAN_API_KEY="OPTIONAL: ETHERSCAN API"

# Optional — have sensible defaults in constants.ts; override only if needed
# NEXT_PUBLIC_PROJECT_URL="https://theinterfold.com/"
# NEXT_PUBLIC_CRISP_INFO_URL="https://docs.theinterfold.com/"
# Extra mining buffer after the protocol's earliest safe voting start.
# NEXT_PUBLIC_MINIMUM_START_DELAY_IN_SECONDS=300
