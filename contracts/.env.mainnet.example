# =============================================================================
# Target network: ETHEREUM MAINNET (chain 1)        ( cp .env.mainnet.example .env.mainnet )
#
# Production parameter set. Use with:
#     make predeploy ENV_FILE=.env.mainnet
#     make deploy    ENV_FILE=.env.mainnet
#     make sync-env  ENV_FILE=.env.mainnet
#     make wire-spp  ENV_FILE=.env.mainnet
#
# Every OSx / plugin-repo address below was resolved from
# @aragon/osx-commons-configs v1.4.6 (or ENS under plugin.dao.eth) and then
# VERIFIED ON-CHAIN against mainnet — see the "verified" notes per entry.
# Re-verify before broadcasting; Aragon can publish new builds at any time.
#
# -----------------------------------------------------------------------------
# BLOCKED — must be filled before this file can deploy. Each is marked TODO(mainnet).
#   1. FOLD_TOKEN_ADDRESS      no mainnet governance token exists yet
#   2. FOUNDATION_ADDRESS      must be a MULTISIG, never an EOA (SECURITY.md)
#   3. INTERFOLD_ADDRESS       no mainnet Interfold E3 coordinator exists yet
#   4. CRISP_PROGRAM_ADDRESS   no mainnet CRISP program / ciphernode set exists yet
#
# (3) and (4) gate the PRIVATE process only. Until the CRISP stack has a mainnet
# deployment, private voting cannot go live — see docs/architecture.md.
# -----------------------------------------------------------------------------
# =============================================================================

# NETWORK / ACCOUNT
RPC_URL="https://ethereum-rpc.publicnode.com"   # replace with a paid endpoint for the deploy
# PRIVATE_KEY=            # deployer; holds ROOT only until wire-spp disarms Admin (INV-29)

# -----------------------------------------------------------------------------
# OSx framework (mainnet) — v1.4.0.
# Verified on-chain: both factories hold their registry permission on the
# management DAO (0xf2d594F3C93C19D7B1a6F15B5489FFcE4B01f7dA):
#   DAOFactory        -> REGISTER_DAO_PERMISSION on DAORegistry         = true
#   PluginRepoFactory -> REGISTER_PLUGIN_REPO_PERMISSION on the registry = true
# NOTE: mainnet differs from Sepolia here — the v1.3.0 DAOFactory
# (0xf96e6FD76BD0A15580604e1Ea5818D448b1041C0) is STILL authorized on mainnet,
# unlike Sepolia where it reverts with DaoUnauthorized. Use v1.4.0 anyway so both
# networks run the same framework build.
# -----------------------------------------------------------------------------
DAO_FACTORY_ADDRESS="0x246503df057A9a85E0144b6867a828c99676128B"
PLUGIN_REPO_FACTORY_ADDRESS="0xcf59C627b7a4052041C4F16B4c635a960e29554A"
# (PluginSetupProcessor, for reference, not read by the script: 0xE978942c691e43f65c1B7c7F8f1dc8cDF061B13f)

# -----------------------------------------------------------------------------
# Governance token.
# TODO(mainnet): deploy or designate FOLD on mainnet. It MUST be ERC20Votes/IVotes;
# both bodies share it. If it is an ERC-6372 `mode=timestamp` token (as the Sepolia
# one is), snapshotBlock holds a TIMESTAMP, not a block number — INV-19.
# -----------------------------------------------------------------------------
FOLD_TOKEN_ADDRESS=""   # TODO(mainnet)

# Only read when the deploy has to create the token (existing-token path ignores them).
TOKEN_NAME="Interfold"
TOKEN_SYMBOL="FOLD"
MINT_SETTINGS_RECEIVERS=""
MINT_SETTINGS_AMOUNT="0"

# -----------------------------------------------------------------------------
# Foundation body — stage 1 of BOTH SPP processes.
# TODO(mainnet): a Safe (or other multisig), NOT an EOA. In `approval` mode losing
# this key freezes governance permanently: every future proposal expires unapproved.
# The post-deploy runbook checks `cast code $FOUNDATION_ADDRESS | wc -c` != 3.
# -----------------------------------------------------------------------------
FOUNDATION_ADDRESS=""   # TODO(mainnet) — multisig

# -----------------------------------------------------------------------------
# Aragon canonical plugin repos (mainnet). All three verified on-chain via
# ENS under plugin.dao.eth, and their release/build read from the repo itself.
# -----------------------------------------------------------------------------

# token-voting.plugin.dao.eth — on-chain: latestRelease=1, buildCount(1)=4.
# Build 4's implementation (0xbbc277951D93e866700471f71616b2c9D304E6F6) is
# byte-identical to the Sepolia build-4 implementation apart from the UUPS
# `__self` immutable — same selector set, same length. So the mainnet build is the
# same clock-aware build, and INV-19 (timestamp snapshots) holds here too.
# Its minDuration floor is still 1 hour: SPP_PUBLIC_VOTE_DURATION must clear it.
TOKEN_VOTING_PLUGIN_REPO="0xb7401cD221ceAFC54093168B814Cc3d42579287f"
TOKEN_VOTING_RELEASE="1"
TOKEN_VOTING_BUILD="4"

# spp.plugin.dao.eth — on-chain: latestRelease=1, buildCount(1)=1 (same shape as Sepolia).
# NOTE the subdomain is `spp`, not `staged-proposal-processor` (that name does not resolve).
SPP_PLUGIN_REPO="0x421FF506E4DC17356965565688D62b55Bf2bf0a5"
SPP_RELEASE="1"
SPP_BUILD="1"

# admin.plugin.dao.eth — on-chain: latestRelease=1, buildCount(1)=2.
# Bootstrap only: wire-spp's final action revokes its EXECUTE on the DAO (INV-29).
ADMIN_PLUGIN_REPO="0xA4371a239D08bfBA6E8894eccf8466C6323A52C3"
ADMIN_RELEASE="1"
ADMIN_BUILD="2"
# ADMIN_ADDRESS=""   # override only if a different account runs wire-spp

# -----------------------------------------------------------------------------
# CRISP plugin repo. Unlike the three above this is OUR repo and does not exist on
# mainnet yet. In the phased rollout phase 1 does NOT mint it — `make publish-crisp-repo`
# (phase 2 step 1) does. Record the address it prints here; `make publish-crisp-build`
# then adds later builds to that repo instead of minting a second one.
# -----------------------------------------------------------------------------
CRISP_PLUGIN_REPO=""
CRISP_RELEASE="1"
CRISP_BUILD="1"

# -----------------------------------------------------------------------------
# Phase 2 plumbing. PSP is the canonical mainnet PluginSetupProcessor (OSx v1.4.0),
# verified on-chain. The PREPARED_* values are printed by `make prepare-private-process`
# and consumed by `make install-private-process`: applyInstallation re-derives the setup
# id from them and reverts on any mismatch, so paste them verbatim.
# -----------------------------------------------------------------------------
PLUGIN_SETUP_PROCESSOR_ADDRESS="0xE978942c691e43f65c1B7c7F8f1dc8cDF061B13f"
PREPARED_CRISP_HELPERS_HASH=""
PREPARED_SPP_HELPERS_HASH=""
PREPARED_CRISP_PERMISSIONS=""
PREPARED_SPP_PERMISSIONS=""

# -----------------------------------------------------------------------------
# PUBLIC body — canonical TokenVoting settings. Ratios are ppm out of 1_000_000.
# (CRISP's MINIMUM_PARTICIPATION below is a % of RATIO_BASE=100 instead — INV-17.
#  Do not copy values between the two.)
# -----------------------------------------------------------------------------
TV_VOTING_MODE="0"             # 0 Standard — no early execution; the SPP decides on the final tally
TV_SUPPORT_THRESHOLD="500000"  # > 50%
TV_MIN_PARTICIPATION="100000"  # 10% quorum
TV_MIN_DURATION="86400"        # 1 day floor (>= the 1h protocol minimum, <= the stage window below)
TV_MIN_PROPOSER_VOTING_POWER="0"  # REVIEW: 0 means anyone with the SPP path can propose
TV_MIN_APPROVALS="0"

# -----------------------------------------------------------------------------
# PHASED ROLLOUT — see docs/mainnet-deployment.md.
# false => phase 1: deploy the DAO with the PUBLIC process only (TokenVoting body +
#          one SPP + Admin bootstrap). The CRISP entries below are not read.
# true  => deploy both processes (the Sepolia default; requires the CRISP TODOs filled).
# Keep this in the env file rather than passing it on the make command line — the
# recipe sources this file last, so a value here wins over a CLI override.
# NOTE: honouring this flag requires the deploy-script changes listed in
# docs/mainnet-deployment.md#prerequisite-code-changes. Until those land, the deploy
# installs all five plugins and reverts on the empty INTERFOLD_ADDRESS below.
# -----------------------------------------------------------------------------
DEPLOY_PRIVATE_PROCESS="false"

# Whether `wire-spp` disarms the Admin bootstrap as its final action.
# false => the Admin plugin stays ARMED after phase 1, so phase 2 can install the private
#          process in one transaction with no vote.
#
#   SECURITY: while armed, the admin EOA can execute ANYTHING on this DAO — re-grant
#   permissions, move treasury funds, replace plugins. Keep the treasury empty until the
#   bootstrap is disarmed, and disarm as soon as installation is finished.
#
# Disarming is never automatic: no deploy and no install performs it. It is its own step,
# `make disarm-admin`, and it is irreversible without a governance proposal (INV-29).
DISARM_ADMIN="false"

# -----------------------------------------------------------------------------
# PRIVATE body — CRISP plugin install settings (Utils.readCrispEnv).
# Phase 2 only — not read while DEPLOY_PRIVATE_PROCESS=false.
# TODO(mainnet): INTERFOLD_ADDRESS and CRISP_PROGRAM_ADDRESS have no mainnet
# deployment. The values below are placeholders; do NOT deploy the private process
# until a mainnet Interfold coordinator + CRISP program + ciphernode set exist, and
# confirm CRISP_PROGRAM_ADDRESS matches the program the CRISP server requests E3s
# against. COMMITTEE_SIZE / PARAM_SET / COMPUTE_PROVIDER_PARAMS must come from that
# same mainnet stack — the values below are carried over from testnet.
# -----------------------------------------------------------------------------
INTERFOLD_ADDRESS=""       # TODO(mainnet)
CRISP_PROGRAM_ADDRESS=""   # TODO(mainnet)

MINIMUM_PARTICIPATION="10"         # 10% of RATIO_BASE(100) — matches the public body's 10%.
                                   # 0 disables quorum entirely and is TESTING ONLY (INV-32).
MINIMUM_DURATION="86400"           # 1 day floor on the creator-chosen CRISP window.
                                   # Must be > 0 in production: it is the only bound on a
                                   # per-proposal duration, and the upper bound is
                                   # (SPP_PRIVATE_VOTE_DURATION + SPP_ADVANCE_WINDOW).
MINIMUM_PROPOSER_VOTING_POWER="1"
MINIMUM_VOTER_VOTING_POWER="1"
COMMITTEE_SIZE="0"                 # TODO(mainnet): confirm against the mainnet ciphernode set
PARAM_SET="0"                      # TODO(mainnet): confirm against the mainnet CRISP program
COMPUTE_PROVIDER_PARAMS="0x7b226e616d65223a225249534330222c22706172616c6c656c223a66616c73652c2262617463685f73697a65223a347d"

# -----------------------------------------------------------------------------
# SPP stage timing (seconds). Read by wire-spp (WireSpp.stagesFor).
# Constraints that must hold (WireSppStages.t.sol enforces the invariants):
#   - SPP_PUBLIC_VOTE_DURATION >= TV_MIN_DURATION and >= 3600, or every public
#     sub-proposal creation reverts (INV-15).
#   - Public stage-0 minAdvance is set to voteDuration automatically (INV-8);
#     private stage-0 minAdvance is 0 and safe (INV-9).
#   - A CRISP proposal's per-proposal window must fit inside
#     SPP_PRIVATE_VOTE_DURATION + SPP_ADVANCE_WINDOW.
# -----------------------------------------------------------------------------
SPP_PRIVATE_VOTE_DURATION="259200"   # 3 days — stage-0 CRISP input window
SPP_PUBLIC_VOTE_DURATION="259200"    # 3 days — stage-0 TokenVoting window
SPP_ADVANCE_WINDOW="604800"          # 7 days to advance a passed stage 0 before it expires
SPP_VETO_DURATION="172800"           # 2 days — stage-1 foundation window
SPP_EXECUTE_WINDOW="2592000"         # 30 days to execute after stage 1 before expiry

# Stage-1 mode: "approval" (opt-in — the foundation must explicitly approve, silence
# expires the proposal) or "veto" (opt-out — silence is consent). Anything that is
# not exactly "veto" falls back to approval (INV-12), so a typo cannot silently
# disable the foundation gate. Changing this later needs no redeploy — a governance
# proposal calling spp.updateStages(...) flips it for future proposals.
SPP_STAGE1_MODE="approval"

# -----------------------------------------------------------------------------
# Post-deploy — filled by `make sync-env ENV_FILE=.env.mainnet`, consumed by wire-spp.
# Leave empty; do not hand-edit.
# -----------------------------------------------------------------------------
DAO_ADDRESS=""
CRISP_VOTING_PLUGIN_ADDRESS=""
TOKEN_VOTING_PLUGIN_ADDRESS=""
SPP_PRIVATE_ADDRESS=""
SPP_PUBLIC_ADDRESS=""
ADMIN_PLUGIN_ADDRESS=""
EXECUTOR_ADDRESS=""
PROPOSAL_METADATA_URI="ipfs://wire-spp"

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Escrow fee-token credit for the DEPLOYER on the CRISP plugin during wire-spp.
# Creator-pays: every proposal creator deposits their own credit (INV-3/INV-4), so
# this only covers proposals the deployer itself creates. Fee token decimals are read
# on-chain (INV-20) — do not assume 18.
CRISP_FEE_DEPOSIT_AMOUNT="0"

# Transfer the Interfold contract's ownership to the DAO. Ownable2Step: this only sets
# the DAO as PENDING owner; the DAO must then execute Interfold.acceptOwnership() via a
# governance proposal to finalize.
TRANSFER_INTERFOLD_OWNERSHIP="false"
