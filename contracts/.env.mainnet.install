# Ethereum mainnet — phase 1 (public process) into the ALREADY-DEPLOYED DAO.
# COMMITTED SNAPSHOT (no secrets: no private key needed — every transaction is signed by the
# foundation Safe). To use:   cp .env.mainnet.install .env.mainnet
# All addresses were read off chain and verified; see docs/public-install-runbook.md.
#
# The DAO here was NOT created by DeployInterfoldDao.s.sol: it was created with the Admin
# plugin only, and the public process (TokenVoting + SPP) is being installed into it.

RPC_URL="https://ethereum-rpc.publicnode.com"   # any mainnet endpoint works; nothing broadcasts from here
PRIVATE_KEY=""   # deliberately empty: every DAO-touching step goes via the Safe

# --- live mainnet addresses (verified on chain) --------------------------------------
DAO_ADDRESS="0x652a31c669f9AB37f6040f279139a75D04F2679e"
ADMIN_PLUGIN_ADDRESS="0xf21E25455988887ee797050080141EBa67b33920"
# TWO DIFFERENT ROLES. Keep them straight:
#
#   FOUNDATION_ADDRESS   the stage-1 approval BODY - who approves proposals. Baked into the SPP
#                        stage config by the install, changeable later via updateStages.
#   ADMIN_DRIVER_ADDRESS who holds EXECUTE_PROPOSAL_PERMISSION on the Admin plugin today, i.e.
#                        who must SIGN the emitted Safe transactions. Not baked into anything.
FOUNDATION_ADDRESS="0x8B43b2852fc5031D01DDfCDF702973D93A2FF593"
ADMIN_DRIVER_ADDRESS="0x8B43b2852fc5031D01DDfCDF702973D93A2FF593"

# Admin-bootstrap rotation: hand the plugin from the current driver to the foundation Safe.
# 2026-08-19: BOTH Safes hold EXECUTE_PROPOSAL_PERMISSION on the Admin plugin (rotation started,
# revoke of 0x5429 outstanding — INV-31). Safe files are emitted from the foundation Safe.
ADMIN_PREDECESSOR_ADDRESS="0x5429D8C7Fd14023f3C414126f94BBe25a05fC018"
ADMIN_SUCCESSOR_ADDRESS="0x8B43b2852fc5031D01DDfCDF702973D93A2FF593"
# BondedVotes — the IVotes wrapper over raw FOLD (0xE172e9B6cfBeeB5593bDcE3f077356FDb33af904)
# + bonding registry + velocker, so bonded FOLD counts toward voting power. ERC-6372
# mode=timestamp (INV-19), 18 decimals, full IVotes surface verified on chain 2026-08-19.
# NOTE: its getPastTotalSupply mirrors the FULL raw FOLD supply (1.2B), so minParticipation
# is a share of ALL FOLD, not of bonded FOLD.
FOLD_TOKEN_ADDRESS="0x028deEA644258c78b1B5B2eacF469F5D781Fb43E"

# --- canonical Aragon OSx v1.4.0 mainnet infrastructure -------------------------------
DAO_FACTORY_ADDRESS="0x246503df057A9a85E0144b6867a828c99676128B"
PLUGIN_REPO_FACTORY_ADDRESS="0xcf59C627b7a4052041C4F16B4c635a960e29554A"
PLUGIN_SETUP_PROCESSOR_ADDRESS="0xE978942c691e43f65c1B7c7F8f1dc8cDF061B13f"

TOKEN_VOTING_PLUGIN_REPO="0xb7401cD221ceAFC54093168B814Cc3d42579287f"
TOKEN_VOTING_RELEASE="1"
TOKEN_VOTING_BUILD="4"        # repo buildCount(1) == 4 on mainnet
SPP_PLUGIN_REPO="0x421FF506E4DC17356965565688D62b55Bf2bf0a5"
SPP_RELEASE="1"
SPP_BUILD="1"                 # repo buildCount(1) == 1 on mainnet
ADMIN_PLUGIN_REPO="0xA4371a239D08bfBA6E8894eccf8466C6323A52C3"
ADMIN_RELEASE="1"
ADMIN_BUILD="2"

# --- public body (TokenVoting) --------------------------------------------------------
# supportThreshold: of the DECISIVE votes, yes/(yes+no) must be strictly > this. Abstain excluded.
# minParticipation: of getPastTotalSupply at the snapshot — BondedVotes mirrors the FULL raw
# FOLD supply (1.2B), so this is a share of ALL FOLD while only bonded FOLD carries votes.
TV_VOTING_MODE="2"             # VoteReplacement — voters may change their vote; no early execution
TV_SUPPORT_THRESHOLD="510000"  # >51% of the decisive votes (yes/(yes+no)), abstain excluded
TV_MIN_PARTICIPATION="20000"   # 2% quorum == 24,000,000 FOLD-worth of voting power must vote
TV_MIN_DURATION="432000"       # 5 days — equal to the stage window, so 5 days is enforced at BOTH
                               # layers: the SPP creates the sub-proposal for exactly this long,
                               # and TokenVoting itself rejects anything shorter.
TV_MIN_PROPOSER_VOTING_POWER="0"  # proposals only ever arrive via the SPP (INV-1/INV-3)
TV_MIN_APPROVALS="0"

# --- SPP staging ----------------------------------------------------------------------
# Stage 0: TokenVoting approval. minAdvance == voteDuration (INV-8) so the SPP decides on the
#          FINAL tally, never an early-reached threshold.
SPP_PUBLIC_VOTE_DURATION="432000"    # 5 days
SPP_ADVANCE_WINDOW="604800"          # +7 days to advance a passed stage 0 before it expires
# Stage 1: foundation approval (opt-in). In approval mode `stagesFor` sets voteDuration = 0 and
#          minAdvance = 0, so approval may land the instant stage 0 closes, and these two are
#          only ever SUMMED into maxAdvance == 5 days for approve-and-execute.
#          Split 2d + 3d rather than 0 + 5d so flipping SPP_STAGE1_MODE=veto later still has a
#          non-zero veto window (INV-11).
SPP_VETO_DURATION="172800"           # 2 days
SPP_EXECUTE_WINDOW="259200"          # 3 days   => stage-1 maxAdvance = 5 days
SPP_STAGE1_MODE="approval"           # foundation must explicitly approve; silence = expiry

# --- rollout flags --------------------------------------------------------------------
DEPLOY_PRIVATE_PROCESS="false"   # public process only; CRISP is a later phase
DISARM_ADMIN="false"             # INV-29 deliberately deferred until the private phase lands

PROPOSAL_METADATA_URI="ipfs://install-public-process"

# Process + body metadata, baked into the install params (changeable later: both plugins grant
# SET_METADATA_PERMISSION to the DAO). JSON sources live in contracts/metadata/; re-pin and
# re-emit the prepare files if they change BEFORE the prepares are executed.
# process: {name: "Interfold Governance Proposal: Public", processKey: "IGPP"}
SPP_METADATA_URI="ipfs://QmUbcjLvWqemx1AzXfDMYsztwPXypi5ykcMyCnn3btLSVT"
# body: {name: "Public Token Voting"}
TV_METADATA_URI="ipfs://Qme5g5x85bsa2ExjsEU3M5rq8rDdk5JJcKhohwZpdVLytX"

# --- filled in as the rollout proceeds -------------------------------------------------
# The stateless Executor contract the bodies DELEGATECALL into (INV-5). NOT a multisig and not
# the foundation Safe - it is a plain helper with no owner, no state and no permissions, and
# pointing this at a Safe makes every body execution revert. This is ARAGON'S CANONICAL v1.4.0
# Executor (osx-commons-configs mainnet.json), verified on chain 2026-08-19: runtime bytecode is
# byte-identical to the Sepolia Executor the Aragon app wires bodies to (0x7a20760b...41A9).
# No deploy needed — nothing to sign. (`make safe-deploy-executor` remains as the CREATE2
# fallback if a self-deployed instance is ever preferred.)
EXECUTOR_ADDRESS="0x56ce4D8006292Abf418291FaE813C1E3769240A4"
TOKEN_VOTING_PLUGIN_ADDRESS=""   # from the TokenVoting InstallationPrepared receipt
SPP_PUBLIC_ADDRESS=""            # from the SPP InstallationPrepared receipt

