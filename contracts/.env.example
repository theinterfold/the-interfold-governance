# =============================================================================
# Target network: SEPOLIA (chain 11155111)         ( cp .env.example .env )
#
# Most addresses below are prefilled from the verified on-chain Sepolia deployment
# and do NOT change on redeploy. You only need to fill:
#   BEFORE deploy:  PRIVATE_KEY, RPC_URL, FOUNDATION_ADDRESS
#   AFTER  deploy:  DAO_ADDRESS + TOKEN_VOTING_PLUGIN_ADDRESS  (for `make lock-public-execution`)
# =============================================================================

# NETWORK / ACCOUNT
PRIVATE_KEY="0x..."
RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# OSx framework (Sepolia) — v1.4.0, verified live + authorized on the (upgraded) registry.
# NOTE: the v1.3.0 factories (0x7a62da7B / 0x07f49c49) are deprecated and revert with
# DaoUnauthorized on the in-place-upgraded registry — use the v1.4.0 ones below.
DAO_FACTORY_ADDRESS="0xB815791c233807D39b7430127975244B36C19C8e"
PLUGIN_REPO_FACTORY_ADDRESS="0x399Ce2a71ef78bE6890EB628384dD09D4382a7f0"

# Shared governance token (Sepolia). NOTE: on-chain symbol is "ENCL" (EnclaveToken),
# the address you provided as FOLD. It IS ERC20Votes/IVotes, so both plugins share it.
# NOTE: FOLD is an ERC-6372 `mode=timestamp` token — snapshots are timestamps, not blocks.
FOLD_TOKEN_ADDRESS="0xB5ECa717Db50010d195fd6908cdBF4589DA08094"

# Aragon canonical TokenVoting PluginRepo (Sepolia). On-chain: latestRelease=1, buildCount=4.
# Build 4 = the v1.4 build, matching the frontend ABI.
TOKEN_VOTING_PLUGIN_REPO="0x424F4cA6FA9c24C03f2396DF0E96057eD11CF7dF"
TOKEN_VOTING_RELEASE="1"
TOKEN_VOTING_BUILD="4"

# Aragon canonical Staged Proposal Processor PluginRepo (Sepolia), release 1 build 1.
# Two SPP instances are installed (PRIVATE + PUBLIC process), each with empty stages;
# `make wire-spp` configures the two-stage flow (voting body -> foundation veto).
SPP_PLUGIN_REPO="0xda62D32C14E8CA78958d6fdC0142A575b0cd6Ad4"
SPP_RELEASE="1"
SPP_BUILD="1"

# Aragon canonical Admin PluginRepo (Sepolia), release 1 build 2. Installed as a bootstrap
# plugin granting the deployer direct execute-on-DAO power, so `make wire-spp` applies the
# staged-governance wiring in ONE tx with no vote; the wiring's final action revokes the
# Admin plugin's EXECUTE on the DAO, disarming it. ADMIN_ADDRESS defaults to the PRIVATE_KEY
# account (the wire-spp broadcaster) — override only if a different account runs wire-spp.
ADMIN_PLUGIN_REPO="0x152c9E28995E418870b85cbbc0AEE4e53020edb2"
ADMIN_RELEASE="1"
ADMIN_BUILD="2"
# ADMIN_ADDRESS=""

# Optional: hand the armed bootstrap to another holder (typically the foundation multisig)
# once the scripted steps are done — `make grant-admin`, the successor proves it with a no-op
# proposal, then `make revoke-admin`. Rotation does NOT disarm.
# ADMIN_SUCCESSOR_ADDRESS=""
# ADMIN_PREDECESSOR_ADDRESS=""       # revoke-admin defaults to the PRIVATE_KEY account
# ADMIN_SUCCESSOR_ALLOW_EOA="false"  # testnets only — bypasses the has-code guard

# Optional: after creating the DAO, transfer the Interfold contract's ownership to it.
# Interfold is Ownable2Step, so this only sets the DAO as PENDING owner — the DAO must then
# execute Interfold.acceptOwnership() via a governance proposal to finalize. The deployer
# (PRIVATE_KEY) must currently be the Interfold owner, or the step no-ops with a log.
TRANSFER_INTERFOLD_OWNERSHIP="false"

# Public (TokenVoting) governance settings for day-to-day proposals. Ratios are ppm out of
# 1_000_000. NOTE: these govern normal governance AFTER wiring — the wiring itself does not
# vote (it runs through the Admin bootstrap plugin).
TV_VOTING_MODE="0"            # 0 Standard, 1 EarlyExecution, 2 VoteReplacement
TV_SUPPORT_THRESHOLD="500000" # > 50%
TV_MIN_PARTICIPATION="100000" # 10%
TV_MIN_DURATION="3600"        # seconds (>= protocol minimum)
TV_MIN_PROPOSER_VOTING_POWER="0"
TV_MIN_APPROVALS="0"

# Foundation address: the manual VETO body in stage 1 of both SPP processes. A passed
# proposal is held for SPP_VETO_DURATION during which the foundation can veto it by calling
# reportProposalResult(proposalId, 1, Veto, false) on the SPP. The DAO is ROOT and can
# reconfigure the stages via governance (updateStages).
FOUNDATION_ADDRESS="0x..."

# POST-DEPLOY / WIRE-SPP: filled by `make sync-env` from the deploy.log, consumed by
# `make wire-spp`, which has the Admin bootstrap plugin execute (in one tx, no vote):
#   - sets the two-stage config on both SPPs (voting body approval -> foundation veto)
#   - grants each SPP CREATE_PROPOSAL on its body plugin
#   - points both bodies at the Executor via delegatecall (so sub-proposal execution
#     reports back to the SPP with the body as msg.sender)
#   - revokes TokenVoting's direct EXECUTE on the DAO (closes the veto bypass)
#   - revokes the Admin plugin's EXECUTE on the DAO (disarms the bootstrap; final action)
DAO_ADDRESS=""
CRISP_VOTING_PLUGIN_ADDRESS=""
TOKEN_VOTING_PLUGIN_ADDRESS=""
SPP_PRIVATE_ADDRESS=""
SPP_PUBLIC_ADDRESS=""
ADMIN_PLUGIN_ADDRESS=""
EXECUTOR_ADDRESS=""
PROPOSAL_METADATA_URI="ipfs://wire-spp"

# SPP stage timing (seconds). Defaults shown; all read by wire-spp with envOr fallbacks.
# SPP_PRIVATE_VOTE_DURATION="3600"   # stage-0 voting window, PRIVATE (CRISP input window)
# SPP_PUBLIC_VOTE_DURATION="3600"    # stage-0 voting window, PUBLIC (>= TokenVoting minDuration!)
# SPP_ADVANCE_WINDOW="604800"        # extra time to advance a passed stage-0 before expiry (7d)
# SPP_VETO_DURATION="172800"         # stage-1 foundation veto window (2d)
# SPP_EXECUTE_WINDOW="2592000"       # time to execute after the veto window before expiry (30d)

# Optional: escrow fee-token credit for the DEPLOYER on the CRISP plugin during wire-spp.
# Creator-pays model: every proposal creator must `deposit` fee credit on the CRISP plugin
# before creating a private proposal through the SPP (the plugin charges the SPP proposal
# creator's credit; failed-E3 refunds are credited back to the payer via claimRefund).
# CRISP_FEE_DEPOSIT_AMOUNT="0"

# CRISP (private) plugin install settings — consumed by Utils.readCrispEnv().
# INTERFOLD_ADDRESS = the current Sepolia Interfold E3 coordinator (exposes feeToken()).
# Used as the CRISP plugin's coordinator AND as the optional ownership-transfer target above.
# Interfold testnet stack deployed 2026-07-16 (3 ciphernodes, private-crisp.theinterfold.com).
INTERFOLD_ADDRESS="0x13fA9Ecff929b4C86a2FCA4AEE91572EDee34486"
# CRISP E3 program (CRISPProgram, same testnet stack). Verify this matches the program the
# CRISP server requests E3s against before going live.
CRISP_PROGRAM_ADDRESS="0x12f7a216aEaB6620dC3488754970b66c63ECdD2C"
# Quorum as a % of RATIO_BASE(100): 1 = 1% (finest step). 0 disables quorum (testing).
MINIMUM_PARTICIPATION="0"
MINIMUM_DURATION="0"
MINIMUM_PROPOSER_VOTING_POWER="1"
MINIMUM_VOTER_VOTING_POWER="1"
COMMITTEE_SIZE="0"
PARAM_SET="0"
COMPUTE_PROVIDER_PARAMS="0x7b226e616d65223a225249534330222c22706172616c6c656c223a66616c73652c2262617463685f73697a65223a347d"
